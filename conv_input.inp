# General paths & dimensions
base_dir ./
ntransitions 5
nsttsN 2
nsttsC 4
skiprows 1

# Transitions and sticks transitions

trans_name_1 PHGS -> PHMGS
trans_file_1 PHGS_PHMGS_DAV.out

trans_name_2 PHGS -> PHMa4Sm
trans_file_2 PHGS_PHMa4Sm_DAV.out

trans_name_3 PHGS -> PHM12Sm
trans_file_3 PHGS_PHM12Sm_DAV.out

trans_name_4 PHa1D -> PHMGS
trans_file_4 PHa1D_PHMGS_DAV.out

trans_name_5 PHa1D -> PHMA2D
trans_file_5 PHa1D_PHMA2D_DAV.out

# Columns -> pandas dataframes
energy_col Delta_eV
Ei_col Ei_eV
vi_col v_i
Ji_col J_i
Omega_i_col Omega_i
intensity_col matrix_coh_sum_abs

# Convolution parameters
sigma 0.015
ngrid 6000
deltaJ_max 1.5
normalize True

# Temperature values
Tvib_values 3500 4000 5000
Trot_values 50 100 150 200

# Experimental data
read_exp True
exp_esp /home/jorgebdelafuente/Doctorado/Photoion/TPES.txt
exp_skiprows 3
exp_energy_col 0
exp_intensity_col 3
state_label_1 PHGS
exp_range_1 10.0 10.2
state_label_2 PHa1D
exp_range_2 9.1 9.5

# Output dir
output_dir first_test
